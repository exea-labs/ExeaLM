#!/bin/bash
# A released model on the study's held-out evaluation, beside our curve models on the same text and bytes
# (experiments/external/build_texts.py, then score_hf.py). One H100 of the shared partition:
#
#     MODEL=/expanse/lustre/projects/fli100/abhatia7/hf/Qwen3.5-9B-Base NAME=qwen35_9b_base \
#         sbatch -A fli100 --export=ALL experiments/external/external.sb
#
# CKPTS (our run folders to score beside it) and TEXTS (where the texts go; reused when they exist) can be set too.
#SBATCH --job-name=exealm-external
#SBATCH --partition=nairr-gpu-shared
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=h100:1
#SBATCH --time=04:00:00
#SBATCH --output=logs/expanse/%x-%j.out
set -uo pipefail
cd "$SLURM_SUBMIT_DIR"
export PYTHONUNBUFFERED=1
: "${MODEL:?set MODEL to the folder of the released model}" "${NAME:?set NAME, e.g. qwen35_9b_base}"
TEXTS=${TEXTS:-/expanse/lustre/projects/fli100/abhatia7/external/texts.jsonl}
CKPTS=${CKPTS:-"runs/exealm_100m_4.1x_s0 runs/qwen_100m_4.1x_s0 runs/llama_100m_4.1x_s0 runs/exealm_250m_4.1x_s0 runs/qwen_250m_4.1x_s0 runs/llama_250m_4.1x_s0"}
if [ ! -s "$TEXTS" ]; then
  echo "== $(date '+%F %T') building the texts and scoring our models on them"
  ( source experiments/expanse/env.sh && python experiments/external/build_texts.py --ckpts $CKPTS --out "$TEXTS" ) \
    || { echo "build_texts failed"; exit 1; }
fi
echo "== $(date '+%F %T') scoring $NAME"
set +u
module load anaconda3/2021.05/q4munrg > /dev/null 2>&1
eval "$(conda shell.bash hook)" && conda activate vllm
set -u
export PYTHONPATH="$SLURM_SUBMIT_DIR${PYTHONPATH:+:$PYTHONPATH}"
python experiments/external/score_hf.py --texts "$TEXTS" --model "$MODEL" --name "$NAME" \
  --out "results/expanse/external_$NAME.json"
echo "== $(date '+%F %T') done"
