#!/bin/bash
# Training speed of the three designs the study compares, on one H100, eager and compiled, as the context grows:
# ExeaLM as it trains now (mid), the same model without its TONN layer (strong) and the Qwen3.5-style model on the
# flash-linear-attention kernel (qwen --fla 1). Each row is experiments/throughput.py: forward, backward and AdamW on
# random tokens, the same tokens a step at every sequence length of a size. Writes results/expanse/speed_*.json.
#
#     sbatch -A fli100 experiments/expanse/diag/speed.sb
#SBATCH --job-name=exealm-speed
#SBATCH --partition=nairr-gpu-shared
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=h100:1
#SBATCH --time=03:00:00
#SBATCH --output=logs/expanse/%x-%j.out
set -uo pipefail
source "$SLURM_SUBMIT_DIR/experiments/expanse/env.sh"
export PYTHONUNBUFFERED=1
cd "$SLURM_SUBMIT_DIR"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
# size:tokens a step; the rows a step at each length keep the tokens the same
for spec in 0.5B:16384 3B:8192; do
  size=${spec%%:*}; tokens=${spec##*:}
  for seq in 512 2048 8192; do
    batch=$(( tokens / seq )); [ "$batch" -ge 1 ] || batch=1
    for comp in 0 1; do
      warm=$([ "$comp" = 1 ] && echo 20 || echo 5)
      python experiments/throughput.py --sizes "$size" --models mid,strong,qwen --precision bf16 --fla 1 \
        --seq "$seq" --batch "$batch" --compile "$comp" --warmup "$warm" --steps 15 \
        --out results/expanse --tag "speed_${size}_${seq}_c${comp}" 2>&1 | grep -v "nvml\|Warning\|warn("
    done
  done
done
echo "== $(date '+%F %T') done"
