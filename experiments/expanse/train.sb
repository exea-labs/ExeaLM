#!/bin/bash
# One training run on one Expanse node, continued over as many 48-hour jobs as it needs. From the repo root:
#
#     export SBATCH_ACCOUNT=<your project>
#     export RUN=exealm_500m_s0
#     export ARGS="--preset 500m --data experiments/expanse/mix_tokpack.json --val data/tokpack/bpe32k/val_en --seq 512 --batch 64 --steps 3000 --lr 1e-3"
#     sbatch experiments/expanse/train.sb
#
# What a job does:
#   1. copies ./data to the node's NVMe and runs from a folder there that looks like the repo (data is the copy, the
#      rest are links), so every path in ARGS, and inside a mix .json, stays as it is in the repo
#   2. brings back the run's last checkpoint from KEEP, if there is one, and continues it (--resume auto)
#   3. trains on all the job's GPUs, writing a checkpoint every SAVE_MIN minutes and copying each one to KEEP
#   4. stops cleanly MARGIN_MIN minutes before the job's time limit, copies the run back, and submits the next job,
#      until the run has written model.pt
# The node's disk is emptied when a job ends, so KEEP is the only place a run survives. A job that crashes is not
# resubmitted: read its output, then submit again by hand and it continues from the last checkpoint in KEEP.
#
# Settings (environment variables; `export` them before sbatch so that the follow-on jobs get them too):
#   RUN         name of the run: its folder under KEEP                                          (required)
#   ARGS        arguments of exealm.train.pretrain, without --out, --resume and the time options (required). Its
#               --batch is the total over the job's GPUs, so a run continued on a different number of GPUs reads
#               the same batches
#   KEEP        where runs are kept: a folder, or s3://bucket/prefix (needs s3cmd)               (default: ./runs)
#   DATA        the packed data to copy in: a folder or s3://bucket/prefix                       (default: ./data)
#   SAVE_MIN    minutes between checkpoints (default 30; 0: none on a timer, but a job that reaches its time limit
#               still writes one to continue from; plan.py sets it per run)
#   MARGIN_MIN  minutes kept for the last save and copy (45)
#   HANG_MIN    a run that has not finished a step in this many minutes is hung: the job stops it and ends (30)
#   KEEP_CKPT   1 keeps a finished run's ckpt.pt (its optimizer state) in KEEP. By default it is removed and model.pt
#               and log.jsonl stay; a learning-rate check (RUN=lr_*) keeps only its log. Home is 100 GB, the data 60
#   JOBS_LEFT   how many more jobs may follow this one (default 20)
#   HF_REPO     a finished run's model.pt and log.jsonl are also uploaded here (default exea-labs/exealm-nairr-runs,
#               private; needs `huggingface-cli login`); HF_REPO="" turns it off
# A different partition, GPU count or time limit: SBATCH_PARTITION, SBATCH_GPUS and SBATCH_TIMELIMIT. Options sbatch
# has no variable for go on its command line and, so that the follow-on jobs get them too, in SBATCH_EXTRA. One GPU
# on the shared partition:
#     export SBATCH_PARTITION=nairr-gpu-shared SBATCH_GPUS=h100:1 SBATCH_EXTRA="--ntasks-per-node=1"
#     sbatch $SBATCH_EXTRA experiments/expanse/train.sb
# The runs of the compute plan: `python experiments/expanse/plan.py --run <name> --lr <rate>` prints these lines.
#
# Only the partition, the GPU type and the time limit below come from SDSC's user guide. Compare the other lines with
# SDSC's own sample (/cm/shared/examples/sdsc/ExpanseAIR/pytorch) and change what differs. Not yet run on Expanse.
#SBATCH --job-name=exealm
#SBATCH --partition=nairr-gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --gpus=h100:4
#SBATCH --time=48:00:00
#SBATCH --output=logs/expanse/%x-%j.out
set -uo pipefail
source "$SLURM_SUBMIT_DIR/experiments/expanse/env.sh"                 # the exealm environment
export PYTHONUNBUFFERED=1                                              # every print reaches the job log at once
: "${RUN:?set RUN to the name of the run}" "${ARGS:?set ARGS to the arguments of exealm.train.pretrain}"
REPO=$SLURM_SUBMIT_DIR
KEEP=${KEEP:-$REPO/runs}
DATA=${DATA:-$REPO/data}
SAVE_MIN=${SAVE_MIN:-30}
MARGIN_MIN=${MARGIN_MIN:-45}
JOBS_LEFT=${JOBS_LEFT:-20}
HANG_MIN=${HANG_MIN:-30}
WORK=${LOCAL_DISK:-/scratch/$USER}/job_$SLURM_JOB_ID                   # the node's own NVMe, emptied when the job ends
OUT=$WORK/runs/$RUN
GPUS=${SLURM_GPUS_ON_NODE:-$(nvidia-smi -L | wc -l | tr -d ' ')}
export PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}"                    # the job runs from the NVMe, not the repo

copy() {                                                               # copy <from>/ <to>/ ; either may be s3://...
  case "$1$2" in
    *s3://*) s3cmd sync --no-progress --exclude '*.tmp' "$1" "$2" ;;
    *)       mkdir -p "$2" && rsync -a --exclude '*.tmp' "$1" "$2" ;;
  esac
}
finished() {                                                           # finished <run folder>: model.pt, or the log's end
  [ -f "$1/model.pt" ] || grep -qs '"event": "end"' "$1/log.jsonl"
}
minutes() {                                                            # Slurm's 2-00:00:00, 12:00:00 or 30:00, in minutes
  python -c "
import sys
d, _, t = sys.argv[1].rpartition('-')
p = [int(x) for x in t.split(':')]
p = [0] * (3 - len(p)) + p
print(int(d or 0) * 1440 + p[0] * 60 + p[1])" "$1"
}

echo "== $(date '+%F %T') job $SLURM_JOB_ID on $(hostname): run $RUN, $GPUS GPU(s), kept in $KEEP"
mkdir -p "$WORK/data" "$OUT"
if [[ $KEEP == s3://* ]] || [ -d "$KEEP/$RUN" ]; then                   # first what is kept, so a finished run stops here
  copy "$KEEP/$RUN/" "$OUT/" || echo "nothing to continue from in $KEEP/$RUN"
fi
finished "$OUT" && { echo "$RUN is already finished"; exit 0; }
[ -f "$OUT/ckpt.pt" ] && echo "continuing from $OUT/ckpt.pt" || echo "starting $RUN from scratch"
echo "== $(date '+%F %T') copying the data ($( [[ $DATA == s3://* ]] && echo "$DATA" || du -sh "$DATA" | cut -f1)) to the node's disk"
copy "$DATA/" "$WORK/data/" || { echo "could not copy the data in"; exit 1; }
echo "== $(date '+%F %T') data copied; training starts. Progress: a line a minute below (step, loss, tokens/s, time left)"

limit=$(squeue -h -j "$SLURM_JOB_ID" -o %l)
max_min=$(( $(minutes "$limit") - MARGIN_MIN ))
[ "$max_min" -gt 0 ] || { echo "the time limit ($limit) is shorter than MARGIN_MIN"; exit 1; }

keep_copying() {                                                       # every new checkpoint goes to KEEP at once
  local seen=""
  while sleep 60; do
    now=$(stat -c %Y "$OUT/ckpt.pt" 2>/dev/null || true)
    if [ -n "$now" ] && [ "$now" != "$seen" ]; then
      copy "$OUT/" "$KEEP/$RUN/" && seen=$now
    fi
  done
}
keep_copying &
copier=$!
disown $copier

for f in "$REPO"/*; do                                                 # the repo's other folders, as links
  [ -e "$WORK/$(basename "$f")" ] || ln -s "$f" "$WORK/"
done
cd "$WORK"                                                             # so data/... in ARGS is the copy on the NVMe
if [ "$GPUS" -gt 1 ]; then launch="torchrun --nproc_per_node $GPUS -m"; else launch="python -m"; fi
$launch exealm.train.pretrain $ARGS --out "$OUT" --resume auto --save_minutes "$SAVE_MIN" --max_minutes "$max_min" \
  --heartbeat "$WORK/heartbeat" &
trainer=$!
watchdog() {           # a run whose heartbeat stops for HANG_MIN minutes is hung (a GPU stuck in a collective, say):
  local since beat limit   # end it, rather than hold the node until the time limit (48 h on a node: 192 GPU-hours)
  since=$(date +%s); limit=${HANG_SECS:-$(( HANG_MIN * 60 ))}
  while sleep "${WATCH_SECS:-30}"; do
    kill -0 "$trainer" 2>/dev/null || return
    beat=$(stat -c %Y "$WORK/heartbeat" 2>/dev/null || stat -f %m "$WORK/heartbeat" 2>/dev/null || echo "$since")
    if [ $(( $(date +%s) - beat )) -gt "$limit" ]; then
      echo "== $(date '+%F %T') HUNG: no training step for $HANG_MIN minutes (last heartbeat: step and time" \
           "$(cat "$WORK/heartbeat" 2>/dev/null)). Stopping the run"
      touch "$WORK/hung"
      kill -TERM "$trainer" 2>/dev/null; sleep 60
      pkill -KILL -P "$trainer" 2>/dev/null; kill -KILL "$trainer" 2>/dev/null
      return
    fi
  done
}
watchdog &
dog=$!
wait "$trainer"
code=$?
kill "$dog" "$copier" 2>/dev/null
case $RUN in lr_*) finished "$OUT" && rm -f "$OUT/model.pt" "$OUT/ckpt.pt" ;; esac   # a learning-rate check: its log
copy "$OUT/" "$KEEP/$RUN/" || { echo "COULD NOT COPY THE RUN BACK: $OUT is lost when this job ends"; exit 1; }

cd "$REPO"
if [ -f "$WORK/hung" ]; then                                           # not resubmitted: a hang needs a look first
  echo "== $(date '+%F %T') $RUN hung and was stopped; its last checkpoint is in $KEEP/$RUN. Read the log above, then"
  echo "   resubmit: python experiments/expanse/plan.py --run $RUN --lr auto | grep -v '^#' | bash"
  exit 1
fi
if finished "$OUT"; then
  echo "== $(date '+%F %T') $RUN finished: $KEEP/$RUN"
  if [ -n "${HF_REPO-exea-labs/exealm-nairr-runs}" ]; then         # a copy off SDSC: the model and its log
    python - "$OUT" "$RUN" "${HF_REPO:-exea-labs/exealm-nairr-runs}" <<'PY' || echo "upload to Hugging Face failed: $KEEP has the run"
import sys
from huggingface_hub import HfApi
out, run, repo = sys.argv[1:4]
api = HfApi()
api.create_repo(repo, repo_type="model", private=True, exist_ok=True)
api.upload_folder(folder_path=out, path_in_repo=f"runs/{run}", repo_id=repo, repo_type="model",
                  allow_patterns=["model.pt", "log.jsonl"])
print(f"uploaded {run} to {repo}")
PY
  fi
  if [ "${KEEP_CKPT:-0}" != 1 ]; then              # a finished run needs no optimizer state: free KEEP for the others
    if [[ $KEEP == s3://* ]]; then s3cmd del --quiet "$KEEP/$RUN/ckpt.pt" > /dev/null 2>&1 || true
    else rm -f "$KEEP/$RUN/ckpt.pt"; fi
    echo "removed $KEEP/$RUN/ckpt.pt (KEEP_CKPT=1 keeps it)"
  fi
elif [ $code -ne 0 ]; then
  echo "== $(date '+%F %T') training failed (exit $code). Not resubmitting. The last checkpoint is in $KEEP/$RUN"
  exit $code
elif [ "$JOBS_LEFT" -le 0 ]; then
  echo "== $(date '+%F %T') stopped at the time limit and JOBS_LEFT is used up. Submit again to continue"
else
  export JOBS_LEFT=$((JOBS_LEFT - 1))
  echo "== $(date '+%F %T') stopped at the time limit. Next job: $(sbatch --parsable ${SBATCH_EXTRA:-} experiments/expanse/train.sb)"
fi
