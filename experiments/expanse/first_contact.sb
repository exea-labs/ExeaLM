#!/bin/bash
# The first job on Expanse: is the model right on an H100, how fast is it, and which ExeaLM should the long runs train?
# About an hour and a half on one node (6 GPU-hours).
# From the repo root, in the environment setup.sh installed into:
#
#     export SBATCH_ACCOUNT=<your project>
#     sbatch experiments/expanse/first_contact.sb
#
# Everything it measures lands in results/expanse/ and the job's output in logs/expanse/. PARTS picks and orders the
# parts:  sbatch --export=ALL,PARTS="check speed" experiments/expanse/first_contact.sb
#
# Only the partition, the GPU type and the time limit below come from SDSC's user guide. Compare the other lines with
# SDSC's own sample (/cm/shared/examples/sdsc/ExpanseAIR/pytorch) and change what differs.
#SBATCH --job-name=exealm-first
#SBATCH --partition=nairr-gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --gpus=h100:4
#SBATCH --time=03:00:00
#SBATCH --output=logs/expanse/%x-%j.out
set -uo pipefail
source "$SLURM_SUBMIT_DIR/experiments/expanse/env.sh"                 # the exealm environment
export PYTHONUNBUFFERED=1                                              # every print reaches the job log at once
cd "$SLURM_SUBMIT_DIR"
PARTS=${PARTS:-"check speed circuits scaling lead"}
OUT=results/expanse
RUNLOGS=logs/expanse/first-$SLURM_JOB_ID                               # each training run's own output: tail -f these
mkdir -p "$RUNLOGS"
echo "== job $SLURM_JOB_ID: parts $PARTS. Each training run writes its progress to $RUNLOGS/<run>.out"
WORK=${LOCAL_DISK:-/scratch/$USER}/job_$SLURM_JOB_ID                   # the node's own NVMe, emptied when the job ends
mkdir -p "$OUT" "$WORK"
localize() {        # localize <mix.json> <out.json>: the mix with its paths on this node's disk ($WORK/data/...)
  python - "$WORK" "$1" > "$2" <<'PY'
import json, sys
work, src = sys.argv[1], sys.argv[2]
mix = json.load(open(src))
for s in mix["sources"].values():
    ps = s["paths"] if isinstance(s["paths"], list) else [s["paths"]]
    ps = [p if p.startswith("/") else f"{work}/{p}" for p in ps]
    s["paths"] = ps if len(ps) > 1 else ps[0]
print(json.dumps(mix))
PY
}
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv

for part in $PARTS; do
  echo "== $(date '+%F %T') $part"
  case $part in
    check)        # the same model on the GPU as on the CPU; training, resume and two processes on two GPUs
      python experiments/gpu_check.py 2>&1 | tee "$OUT/gpu_check.txt" ;;
    speed)        # one GPU, as measured on the MI300X; two switches at 0.5B; then the plan's three models at every
                  # size, which ends with the compute plan at the rates of this GPU
      export CUDA_VISIBLE_DEVICES=0
      python experiments/throughput.py --out "$OUT" --tag h100
      python experiments/throughput.py --out "$OUT" --tag h100 --sizes 0.5B --models hybrid,llama --precision bf16 \
        --compile 1 --warmup 25
      python experiments/throughput.py --out "$OUT" --tag h100 --sizes 0.5B --models hybrid,llama --precision bf16 --tf32 1
      python experiments/throughput.py --out "$OUT" --tag h100 --sizes 0.1B,0.25B,0.5B,3B --models hybrid,llama,qwen \
        --precision bf16 | tee "$OUT/plan_at_h100_rates.txt"
      unset CUDA_VISIBLE_DEVICES ;;
    circuits)     # which circuit types gain least from bf16 (an open to-do from the MI300X session)
      for amp in none bf16; do
        CUDA_VISIBLE_DEVICES=0 python experiments/profile_circuits.py --amp $amp > "$OUT/profile_circuits_$amp.json"
      done ;;
    scaling)      # the real training loop at 0.5B on real tokens from the local disk: 1 GPU against 4
      echo "== $(date '+%F %T') copying data/ ($(du -sh data | cut -f1)) to the node's disk"
      { rsync -a --exclude "library*/" data/ "$WORK/data/"; rc=$?; [ $rc = 0 ] || [ $rc = 24 ]; } && echo "== $(date '+%F %T') data copied"
      localize data/mix_pretrain.json "$WORK/mix.json"; localize data/mix_pretrain_val.json "$WORK/mix_val.json"
      # 16 rows on each GPU: --batch is the total, so 64 on four. Both evaluate the same 32 rows.
      args="--preset 500m --data $WORK/mix.json --val $WORK/mix_val.json --config experiments/expanse/exealm_core.json
            --seq 512 --steps 150 --eval_every 50 --search 0"
      echo "== $(date '+%F %T') scaling: 150 steps at 0.5B on 1 GPU, then on 4; follow with tail -f $RUNLOGS/scale_*.out"
      CUDA_VISIBLE_DEVICES=0 python -m exealm.train.pretrain $args --batch 16 --eval_batches 2 \
        --out "$WORK/runs/scale_1gpu" > "$RUNLOGS/scale_1gpu.out" 2>&1
      torchrun --nproc_per_node 4 -m exealm.train.pretrain $args --batch 64 --eval_batches 1 \
        --out "$WORK/runs/scale_4gpu" > "$RUNLOGS/scale_4gpu.out" 2>&1
      python - "$WORK/runs" "$OUT/scaling_500m.json" <<'PY'
import json, sys
rows = {}
for name in ("scale_1gpu", "scale_4gpu"):
    last = [json.loads(l) for l in open(f"{sys.argv[1]}/{name}/log.jsonl") if '"eval"' in l][-1]   # past the warm-up
    rows[name] = {k: last.get(k) for k in ("tokens_per_sec", "gpu_mem_gb", "processes_in_sync", "val_bits_per_token")}
rows["speedup_on_4_gpus"] = round(rows["scale_4gpu"]["tokens_per_sec"] / rows["scale_1gpu"]["tokens_per_sec"], 2)
json.dump(rows, open(sys.argv[2], "w"), indent=1)
print(json.dumps(rows, indent=1))
PY
      ;;
    lead)         # Does ExeaLM lead the plain Llama and the base Qwen3.5-style model at 0.1B on an H100 in bf16, on
                  # the study's data, trained as the plan trains them? ExeaLM: one window per row, then rows of 4
                  # streamed windows for the last 20%; the baselines: one window per row throughout; the same 16,384
                  # tokens per step. 3 seeds x 3 models, one run per GPU
      echo "== $(date '+%F %T') copying data/ ($(du -sh data | cut -f1)) to the node's disk"
      { rsync -a --exclude "library*/" data/ "$WORK/data/"; rc=$?; [ $rc = 0 ] || [ $rc = 24 ]; } && echo "== $(date '+%F %T') data copied"
      localize data/mix_pretrain.json "$WORK/mix.json"; localize data/mix_pretrain_val.json "$WORK/mix_val.json"
      args="--preset 100m --data $WORK/mix.json --val $WORK/mix_val.json --seq 512
            --steps 3000 --warmup 200 --lr 1e-3 --search 0 --eval_every 500"
      for seed in 0 1 2; do
        echo "== $(date '+%F %T') lead check, seed $seed (of 0, 1, 2): Llama, ExeaLM and Qwen3.5-style side by side;" \
             "follow them with: tail -f $RUNLOGS/lead_*_s$seed.out"
        CUDA_VISIBLE_DEVICES=0 python -m exealm.train.pretrain $args --batch 32 --seed $seed --model llama \
          --out "$WORK/runs/lead_llama_s$seed" > "$RUNLOGS/lead_llama_s$seed.out" 2>&1 &
        CUDA_VISIBLE_DEVICES=1 python -m exealm.train.pretrain $args --stream 4 --stream_from 0.8 --batch 8 \
          --seed $seed --config experiments/expanse/exealm_core.json --out "$WORK/runs/lead_exealm_s$seed" > "$RUNLOGS/lead_exealm_s$seed.out" 2>&1 &
        CUDA_VISIBLE_DEVICES=2 python -m exealm.train.pretrain $args --batch 32 --seed $seed --model llama \
          --config experiments/expanse/qwen_100m.json --out "$WORK/runs/lead_qwen_s$seed" > "$RUNLOGS/lead_qwen_s$seed.out" 2>&1 &
        wait
        for f in "$RUNLOGS"/lead_*_s$seed.out; do                       # each run's last evaluation
          echo "   $(basename "$f" .out): $(grep '"event": "eval"' "$f" | tail -1 | cut -c1-160)"
        done
      done
      CUDA_VISIBLE_DEVICES=0 python experiments/eval_text.py "$WORK"/runs/lead_llama_s? "$WORK"/runs/lead_exealm_s? \
        "$WORK"/runs/lead_qwen_s? --mix "$WORK/mix_val.json" --out "$OUT/lead_100m.json" ;;
    *) echo "unknown part: $part" ;;
  esac
done
echo "== $(date '+%F %T') done. Results: $OUT/"
