#!/bin/bash
# Why did ExeaLM trail the plain Llama and the Qwen3.5-style model in the first job's lead check at 0.1B (new data,
# streams in ExeaLM's last 20%)? The same 0.1B runs as that check (3,000 steps of 16,384 tokens, warm-up 200), changing
# one thing at a time, scored by eval_text.py on the same fixed windows as results/expanse/lead_100m.json:
#   nostream_s0..s2   ExeaLM as planned but one window per row throughout (the MI300X runs never streamed)
#   nostream_lr2e-3   the same at twice the learning rate;  nostream_lr5e-4  at half
#   every3            a TONN layer every third layer, not every fourth (no streams)
#   no_vr_xsa         without value residual and XSA (no streams)
#   late_stream_s0    the plan's ExeaLM again (streams in the last 20%), to tie this job to the lead check
# One node, about 35 minutes (about 2.5 GPU-hours):
#
#     sbatch experiments/expanse/diagnose.sb
#     tail -f logs/expanse/exealm-diagnose-<job id>.out
#SBATCH --job-name=exealm-diagnose
#SBATCH --partition=nairr-gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --gpus=h100:4
#SBATCH --time=01:30:00
#SBATCH --output=logs/expanse/%x-%j.out
set -uo pipefail
export PYTHONUNBUFFERED=1
cd "$SLURM_SUBMIT_DIR"
OUT=results/expanse
RUNLOGS=logs/expanse/diagnose-$SLURM_JOB_ID
WORK=${LOCAL_DISK:-/scratch/$USER}/job_$SLURM_JOB_ID
mkdir -p "$OUT" "$RUNLOGS" "$WORK/runs"
localize() {        # localize <mix.json> <out.json>: the mix with its paths on this node's disk ($WORK/data/...)
  python - "$WORK" "$1" > "$2" <<'PY'
import json, sys
work, src = sys.argv[1], sys.argv[2]
mix = json.load(open(src))
for s in mix["sources"].values():
    ps = s["paths"] if isinstance(s["paths"], list) else [s["paths"]]
    ps = [p if p.startswith("/") else f"{work}/{p}" for p in ps]
    s["paths"] = ps if len(ps) > 1 else ps[0]
print(json.dumps(mix))
PY
}
echo "== $(date '+%F %T') job $SLURM_JOB_ID: each run writes its progress to $RUNLOGS/<run>.out"
echo "== $(date '+%F %T') copying data/ ($(du -sh data | cut -f1)) to the node's disk"
rsync -a data/ "$WORK/data/" && echo "== $(date '+%F %T') data copied"
localize data/mix_pretrain.json "$WORK/mix.json"; localize data/mix_pretrain_val.json "$WORK/mix_val.json"

args="--preset 100m --data $WORK/mix.json --val $WORK/mix_val.json --seq 512 --steps 3000 --warmup 200 --search 0
      --eval_every 500"
core=experiments/expanse/exealm_core.json
one() {             # one <name> <gpu> <args...>: a run on one GPU, in the background
  local name=$1 gpu=$2; shift 2
  CUDA_VISIBLE_DEVICES=$gpu python -m exealm.train.pretrain $args "$@" --out "$WORK/runs/$name" \
    > "$RUNLOGS/$name.out" 2>&1 &
}
echo "== $(date '+%F %T') round 1 of 2: ExeaLM without streams, 3 seeds, and at twice the learning rate"
one nostream_s0 0 --config $core --batch 32 --lr 1e-3 --seed 0
one nostream_s1 1 --config $core --batch 32 --lr 1e-3 --seed 1
one nostream_s2 2 --config $core --batch 32 --lr 1e-3 --seed 2
one nostream_lr2e-3_s0 3 --config $core --batch 32 --lr 2e-3 --seed 0
wait
echo "== $(date '+%F %T') round 2 of 2: half the learning rate, every third layer, no value residual or XSA, and the plan"
one nostream_lr5e-4_s0 0 --config $core --batch 32 --lr 5e-4 --seed 0
one every3_s0 1 --config experiments/expanse/diag/every3.json --batch 32 --lr 1e-3 --seed 0
one no_vr_xsa_s0 2 --config experiments/expanse/diag/no_vr_xsa.json --batch 32 --lr 1e-3 --seed 0
one late_stream_s0 3 --config $core --stream 4 --stream_from 0.8 --batch 8 --lr 1e-3 --seed 0
wait
for f in "$RUNLOGS"/*.out; do                                          # each run's last in-run evaluation
  echo "   $(basename "$f" .out): $(grep '"event": "eval"' "$f" | tail -1 | python -c 'import sys,json; l=sys.stdin.read().strip(); print(json.loads(l).get("val_bits_per_byte") if l else "no evaluation: read the log")')"
done
echo "== $(date '+%F %T') scoring every run on the same windows as lead_100m.json"
CUDA_VISIBLE_DEVICES=0 python experiments/eval_text.py "$WORK"/runs/* --mix "$WORK/mix_val.json" \
  --out "$OUT/diagnose_100m.json"
echo "== $(date '+%F %T') done: $OUT/diagnose_100m.json"
