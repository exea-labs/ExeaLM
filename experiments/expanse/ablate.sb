#!/bin/bash
# What each part of ExeaLM adds at 0.1B on the study's data, and how the baselines do with ExeaLM's two attention
# changes: the ablation table of the paper. The same runs as the first job's lead check (3,000 steps of 16,384
# tokens, warm-up 200, learning rate 1e-3), one change at a time, scored by eval_text.py on the same fixed windows as
# results/expanse/lead_100m.json (the plan's ExeaLM, Qwen3.5-style and Llama, 3 seeds each):
#   nostream_s0..s2    ExeaLM without its stream phase (one window per row throughout)
#   no_vr_xsa_s0..s2   ExeaLM without value residual and XSA (no streams): the hybrid's own share of the lead
#   every3_s0          a TONN layer every third layer instead of every fourth (no streams)
#   nostream_lr2e-3_s0, nostream_lr5e-4_s0   ExeaLM (no streams) at twice and half the learning rate
#   llama_two_s0..s2   a Llama with gated attention, QK-norm, value residual and XSA (the reviewer's question)
#   qwen_two_s0        the Qwen3.5-style model with value residual and XSA
# One node, about 50 minutes (about 3.5 GPU-hours):
#
#     sbatch experiments/expanse/ablate.sb
#     tail -f logs/expanse/exealm-ablate-<job id>.out
#SBATCH --job-name=exealm-ablate
#SBATCH --partition=nairr-gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=8
#SBATCH --gpus=h100:4
#SBATCH --time=01:45:00
#SBATCH --output=logs/expanse/%x-%j.out
set -uo pipefail
export PYTHONUNBUFFERED=1
cd "$SLURM_SUBMIT_DIR"
OUT=results/expanse
RUNLOGS=logs/expanse/ablate-$SLURM_JOB_ID
WORK=${LOCAL_DISK:-/scratch/$USER}/job_$SLURM_JOB_ID
mkdir -p "$OUT" "$RUNLOGS" "$WORK/runs"
localize() {        # localize <mix.json> <out.json>: the mix with its paths on this node's disk ($WORK/data/...)
  python - "$WORK" "$1" > "$2" <<'PY'
import json, sys
work, src = sys.argv[1], sys.argv[2]
mix = json.load(open(src))
for s in mix["sources"].values():
    ps = s["paths"] if isinstance(s["paths"], list) else [s["paths"]]
    ps = [p if p.startswith("/") else f"{work}/{p}" for p in ps]
    s["paths"] = ps if len(ps) > 1 else ps[0]
print(json.dumps(mix))
PY
}
echo "== $(date '+%F %T') job $SLURM_JOB_ID: each run writes its progress to $RUNLOGS/<run>.out"
echo "== $(date '+%F %T') copying data/ ($(du -sh data | cut -f1)) to the node's disk"
rsync -a data/ "$WORK/data/" && echo "== $(date '+%F %T') data copied"
localize data/mix_pretrain.json "$WORK/mix.json"; localize data/mix_pretrain_val.json "$WORK/mix_val.json"

args="--preset 100m --data $WORK/mix.json --val $WORK/mix_val.json --seq 512 --steps 3000 --warmup 200 --search 0
      --eval_every 500 --batch 32"
core=experiments/expanse/exealm_core.json
D=experiments/expanse/diag
gpu() {             # gpu <gpu> <name> <args...> [-- <name> <args...>]...: runs one after another on one GPU
  local g=$1; shift
  ( while [ $# -gt 0 ]; do
      local name=$1; shift; local run_args=()
      while [ $# -gt 0 ] && [ "$1" != -- ]; do run_args+=("$1"); shift; done
      [ $# -gt 0 ] && shift
      CUDA_VISIBLE_DEVICES=$g python -m exealm.train.pretrain $args "${run_args[@]}" --out "$WORK/runs/$name" \
        > "$RUNLOGS/$name.out" 2>&1
    done ) &
}
echo "== $(date '+%F %T') round 1 of 3: ExeaLM without streams (3 seeds); without value residual and XSA"
gpu 0 nostream_s0 --config $core --lr 1e-3 --seed 0
gpu 1 nostream_s1 --config $core --lr 1e-3 --seed 1
gpu 2 nostream_s2 --config $core --lr 1e-3 --seed 2
gpu 3 no_vr_xsa_s0 --config $D/no_vr_xsa.json --lr 1e-3 --seed 0
wait
echo "== $(date '+%F %T') round 2 of 3: without value residual and XSA (seeds 1, 2); every third layer; gated Llama with both"
gpu 0 no_vr_xsa_s1 --config $D/no_vr_xsa.json --lr 1e-3 --seed 1
gpu 1 no_vr_xsa_s2 --config $D/no_vr_xsa.json --lr 1e-3 --seed 2
gpu 2 every3_s0 --config $D/every3.json --lr 1e-3 --seed 0
gpu 3 llama_two_s0 --model llama --config $D/llama_two.json --lr 1e-3 --seed 0 -- \
      llama_two_s1 --model llama --config $D/llama_two.json --lr 1e-3 --seed 1
wait
echo "== $(date '+%F %T') round 3 of 3: Qwen3.5-style with both; ExeaLM at two other learning rates; gated Llama with both, seed 2"
gpu 0 qwen_two_s0 --model llama --config $D/qwen_two.json --lr 1e-3 --seed 0
gpu 1 nostream_lr2e-3_s0 --config $core --lr 2e-3 --seed 0
gpu 2 nostream_lr5e-4_s0 --config $core --lr 5e-4 --seed 0
gpu 3 llama_two_s2 --model llama --config $D/llama_two.json --lr 1e-3 --seed 2
wait
for f in "$RUNLOGS"/*.out; do                                          # each run's last in-run evaluation
  echo "   $(basename "$f" .out): $(grep '"event": "eval"' "$f" | tail -1 | python -c 'import sys,json; l=sys.stdin.read().strip(); print(json.loads(l).get("val_bits_per_byte") if l else "no evaluation: read the log")')"
done
echo "== $(date '+%F %T') scoring every run on the same windows as lead_100m.json"
CUDA_VISIBLE_DEVICES=0 python experiments/eval_text.py "$WORK"/runs/* --mix "$WORK/mix_val.json" \
  --out "$OUT/ablation_100m.json"
python - "$OUT" "${HF_REPO:-exea-labs/exealm-nairr-runs}" <<'PY' || echo "upload failed: the results are in results/expanse"
import sys
from huggingface_hub import HfApi
out, repo = sys.argv[1:3]
api = HfApi()
api.create_repo(repo, repo_type="model", private=True, exist_ok=True)
api.upload_folder(folder_path=out, path_in_repo="results/expanse", repo_id=repo, repo_type="model")
print("uploaded", out, "to", repo)
PY
echo "== $(date '+%F %T') done: $OUT/ablation_100m.json"
