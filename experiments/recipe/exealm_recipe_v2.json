{
 "name": "exealm-recipe-v2.1",
 "date": "2026-11-25",
 "total_pretrain_tokens_b": 300.0,
 "priority": "research code > general code > research papers > math > everything else",
 "scale_note": "targets are at the full 300B; the first slice (about 30B) takes every source at its share, shards in a fixed shuffled order",
 "slices": {
  "first": 30,
  "full": 300
 },
 "splits": {
  "validation": "0.1% of every source's documents, plus long documents (>= 4,096 tokens) kept whole for the long-document test",
  "pretrain": "everything else",
  "anneal": "the last 10% of steps reweight by anneal_weight",
  "post": "the post list below",
  "fine_tune": "library tasks and our own generated tasks, held-out topics kept apart"
 },
 "decontamination": "every benchmark we report (HumanEval, MBPP test, APPS test, CodeContests test, LiveCodeBench, GSM8K test, MATH test, ARC test, MMLU, SciQ, PubMedQA): 13-gram overlap removed from all pretraining and post-training text",
 "excluded": [
  "FineWeb-Edu, FineMath and LLM-jp's en_fineweb/en_finemath: scored with Llama 3 models",
  "benchmark test splits, anywhere"
 ],
